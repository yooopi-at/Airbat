# SMTP server used to deliver contact, sign-up and newsletter form submissions
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465), "false" for STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Sender and recipient for form notification emails
MAIL_FROM="Airbat Website <no-reply@example.com>"
MAIL_TO=sales@example.com

# Public URL of the site, required in production behind a proxy (e.g. Coolify) so
# SvelteKit's CSRF check accepts form submissions. Not needed for `pnpm dev`.
ORIGIN=https://www.example.com
